                    contentDescription = BBLocalization.Current.Get(key = "5a440cd9-a690-4baf-86ec-f79bb9b5ebcf", fallback = "Seçili dil"),
                    tint = BBColors.Yellow.Yellow500,
                    modifier = Modifier.size(
                        BBIcon.SizeLg
                    )
                )
            }
        }
