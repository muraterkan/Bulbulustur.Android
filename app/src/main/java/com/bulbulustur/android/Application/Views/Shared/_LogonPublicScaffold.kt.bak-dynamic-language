        border = BorderStroke(
            width = BBSpacing.Divider,
            color = if (isSelected) {
                BBColors.Yellow.Yellow400
            } else {
                MaterialTheme.colorScheme.outlineVariant
            }
        )
    ) {
        Row(
            modifier = Modifier
                .fillMaxWidth()
